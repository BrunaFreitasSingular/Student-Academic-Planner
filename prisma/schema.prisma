datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

enum SubjectType {
  REQUIRED
  ELECTIVE
  COMPLEMENTARY
}

model Subject {
  id       Int    @id @default(autoincrement())
  name     String
  credits  Int
  year     Int
  semester Int
  status   String

  // forager key
  id_user Int
  user    User @relation(fields: [id_user], references: [id])

  totalAssessments Int
  assessments      Assessment[]

  type SubjectType
}

model Assessment {
  id Int @id @default(autoincrement())
  title  String
  grade  Float
  weight Float

  // forager key
  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id])

}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  semester Int

  // Relationships
  subjects Subject[]

  // forager key
  course_id Int
  course   Course @relation(fields: [course_id], references: [id])
}

model Course {
  id                         Int @id @default(autoincrement())
  name                       String
  requiredCredits            Int
  electiveCredits            Int
  complementaryCredits       Int

  users User[]
}
