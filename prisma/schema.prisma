datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Subject {
  id        Int      @id @default(autoincrement())
  name      String
  credits   Int
  year      Int
  semester  Int
  status    String
  id_user   Int
  totalLessons Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
