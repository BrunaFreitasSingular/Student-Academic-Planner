{
  "compilerOptions": {
    "target": "ES2022",
    "lib":["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node","jest"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
  },
  "include": ["src/**/*", "src/infrastructure/database/prismaClient.ts", "jest.config.ts"],
  "exclude": ["node_modules"]
}